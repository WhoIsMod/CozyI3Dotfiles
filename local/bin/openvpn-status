#!/usr/bin/env bash
: "${HOME:=$(getent passwd "$(id -un)" | cut -d: -f6)}"; export HOME
# Waybar JSON status for the OpenVPN tray-style module.
PID_FILE=/run/openvpn-gui.pid
LOG_FILE=/run/openvpn-gui.log
ACTIVE_FILE="$HOME/.local/state/openvpn-gui/active"

LOCK=$(printf '\xef\x80\xa3')     # U+F023 connected
UNLOCK=$(printf '\xef\x82\x9c')   # U+F09C disconnected
SYNC=$(printf '\xef\x80\xa1')     # U+F021 connecting

esc() { local s="${1//\\/\\\\}"; echo "${s//\"/\\\"}"; }

running=0
if [[ -r $PID_FILE ]]; then
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    [[ -n "$pid" && -d "/proc/$pid" ]] && running=1
fi

if (( ! running )); then
    printf '{"text":"%s  VPN","class":"disconnected","tooltip":"VPN: disconnected\\nClick: choose a config"}\n' "$UNLOCK"
    exit 0
fi

name="$(cat "$ACTIVE_FILE" 2>/dev/null || echo "?")"
ip="$(ip -4 -o addr show 2>/dev/null | awk '$2 ~ /^tun/ {print $4; exit}')"

if [[ -n "$ip" ]]; then
    printf '{"text":"%s  VPN","class":"connected","tooltip":"VPN: connected\\n%s\\n%s\\nClick: menu, right-click: disconnect"}\n' \
        "$LOCK" "$(esc "$name")" "$ip"
else
    printf '{"text":"%s  VPN","class":"connecting","tooltip":"VPN: connecting to %s..."}\n' "$SYNC" "$(esc "$name")"
fi
