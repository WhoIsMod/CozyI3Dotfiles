#!/usr/bin/env bash
: "${HOME:=$(getent passwd "$(id -un)" | cut -d: -f6)}"; export HOME
# Focus OBS if it is running, otherwise launch it (native or Flatpak).
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
if pgrep -x obs >/dev/null 2>&1; then
    i3-msg '[class="obs"] focus' >/dev/null 2>&1 \
        || i3-msg '[class="com.obsproject.Studio"] focus' >/dev/null 2>&1
elif command -v obs >/dev/null 2>&1; then
    setsid -f obs >/dev/null 2>&1
elif command -v flatpak >/dev/null 2>&1 && flatpak info com.obsproject.Studio >/dev/null 2>&1; then
    setsid -f flatpak run com.obsproject.Studio >/dev/null 2>&1
else
    notify-send "OBS" "OBS Studio is not installed" 2>/dev/null
fi
