#!/usr/bin/env bash
: "${HOME:=$(getent passwd "$(id -un)" | cut -d: -f6)}"; export HOME
# Battery with the same icons and colours as the Sway panel (yellow <= 30%, red <= 15%).
bat="$(ls -d "${BAT_DIR:-/sys/class/power_supply}"/BAT* 2>/dev/null | head -n1)"
[[ -n "$bat" ]] || exit 0
cap="$(cat "$bat/capacity" 2>/dev/null)"; st="$(cat "$bat/status" 2>/dev/null)"
[[ -n "$cap" ]] || exit 0
icons=("$(printf '\xef\x89\x84')" "$(printf '\xef\x89\x83')" "$(printf '\xef\x89\x82')" "$(printf '\xef\x89\x81')" "$(printf '\xef\x89\x80')")
i=$(( cap / 20 )); (( i > 4 )) && i=4
green='#a9d9a0'; color="$green"
case "$st" in
    Charging)        icon="$(printf '\xef\x83\xa7')" ;;   # bolt
    Full|"Not charging") icon="$(printf '\xef\x87\xa6')" ;;   # plug
    *)  icon="${icons[$i]}"
        if (( cap <= 15 )); then color='#ef8e9a'; elif (( cap <= 30 )); then color='#ecd08a'; fi ;;
esac
printf '%%{F%s}%s %s%%%%{F-}\n' "$color" "$icon" "$cap"
