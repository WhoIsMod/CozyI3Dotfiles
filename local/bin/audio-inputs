#!/usr/bin/env bash
: "${HOME:=$(getent passwd "$(id -un)" | cut -d: -f6)}"; export HOME
# Diagnose and enable microphone / line-in / headset (inline) mic inputs on PipeWire.
# Usage: audio-inputs [status|fix]
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
set -uo pipefail

real_sources() { pactl list short sources 2>/dev/null | awk '$2 !~ /\.monitor$/ {print $2}'; }
alsa_cards()   { awk '/^ *[0-9]+ \[/ {print $1}' /proc/asound/cards 2>/dev/null; }

jack_val() {   # jack_val <alsa card> <control name>  -> on/off
    amixer -c "$1" contents 2>/dev/null \
      | awk -v want="name='$2'" 'index($0, want) {f=1; next} f && /: values=/ {sub(/.*values=/, ""); print; exit}'
}

verdict() {
    local c n found_mic=0 found_hp=0
    echo; echo "== Verdict for the 3.5 mm (aux) jack =="
    if pactl list cards 2>/dev/null | grep -q 'Active Profile: pro-audio'; then
        echo "  NOTE: a sound card is on the 'Pro Audio' profile (raw devices, no jack/port switching,"
        echo "  and its first input may be muted). In pavucontrol -> Configuration pick a normal profile,"
        echo "  or run 'audio-inputs fix'. If only Off/Pro Audio are offered, update alsa-ucm-conf and"
        echo "  sof-firmware and reboot."
    fi
    for c in $(alsa_cards); do
        for n in 'Mic Jack' 'Headset Mic Jack' 'Headphone Mic Jack' 'Line In Jack'; do
            [[ "$(jack_val "$c" "$n")" == on ]] && found_mic=1
        done
        [[ "$(jack_val "$c" 'Headphone Jack')" == on ]] && found_hp=1
    done
    if (( found_mic )); then
        echo "  OK: the codec reports a microphone/line contact on the jack."
        echo "  Select that input in pavucontrol, raise the input level and 'Mic Boost'/'Capture'"
        echo "  (alsamixer -c 0, F4). Condenser mics are quiet."
    elif (( found_hp )); then
        echo "  PROBLEM: the codec sees your plug as HEADPHONES only: 'Headphone Jack' is on, the mic"
        echo "  jack is off. A 3-pole mic plug in a 4-pole headset (combo) jack does this, and no"
        echo "  software setting can fix it. Use a mic-to-headset (TRS to TRRS) adapter, a USB sound"
        echo "  card, or a laptop with a separate mic-in jack."
    else
        echo "  Nothing is detected on the jack. Re-plug the cable fully and run this again."
        echo "  If the jack lines above never change when plugging in, jack detection isn't working:"
        echo "  try 'hdajackretask' (package alsa-tools) or a USB sound card."
    fi
}

status() {
    echo "== Services =="
    for s in pipewire pipewire-pulse wireplumber; do
        printf '  %-14s %s\n' "$s" "$(systemctl --user is-active "$s" 2>/dev/null)"
    done

    echo; echo "== ALSA capture hardware (arecord -l) =="
    arecord -l 2>&1 | sed 's/^/  /'

    echo; echo "== USB devices (a USB microphone shows up here and as its own sound card, not under the laptop jack) =="
    lsusb 2>/dev/null | sed 's/^/  /'
    journalctl -k -b --no-pager 2>/dev/null | grep -iE 'usb.*(audio|microphone|sound)|snd-usb-audio' | tail -4 | sed 's/^/  /'

    echo; echo "== PipeWire inputs (what pavucontrol -> Input Devices shows) =="
    pactl list sources 2>/dev/null \
      | awk -v RS='Source #' 'NR>1 && $0 !~ /Name: [^ \t\n]*\.monitor/ {print "Source #" $0}' \
      | grep -E 'Source #|^\s+(Name|Description|Mute|Volume|Active Port):|\(type:' | sed 's/^/  /'
    n="$(real_sources | wc -l)"
    echo "  -> $n input device(s) found"

    echo; echo "== Jack detection (kernel; values should flip on/off when you plug a cable) =="
    for c in $(alsa_cards); do
        amixer -c "$c" contents 2>/dev/null | grep -iE -A2 "name='[^']*jack'" | grep -E "name=|: values=" | sed 's/^/  /'
    done

    echo; echo "== Audio firmware messages =="
    journalctl -k -b --no-pager 2>/dev/null | grep -iE 'sof.*(firmware|fail|error)|snd_hda.*(fail|error)' | tail -4 | sed 's/^/  /'

    if (( n == 0 )); then
        cat <<'HINT'

No input device is visible to PipeWire. Common causes:
  - missing firmware/UCM files: install sof-firmware + alsa-ucm-conf (Debian: firmware-sof-signed), reboot
  - a headset's mic is wired differently from your jack (CTIA vs OMTP), or the jack is
    headphone-only: try a different headset or a USB/analog splitter adapter
  - the jack isn't detected by the kernel (jack values above never change): try
    `hdajackretask` (package alsa-tools) to retask the pin as a headset mic
  - capture is muted in `alsamixer -c 0` (press F4, unmute with M)
Run `audio-inputs fix`, plug the headset in again, then check pavucontrol.
HINT
    else
        echo; echo "In pavucontrol open Input Devices and set 'Show:' to 'All Input Devices'"
        echo "so inputs on an unplugged or unavailable port are not hidden."
    fi
    verdict
}

fix() {
    systemctl --user enable --now pipewire pipewire-pulse wireplumber >/dev/null 2>&1 || true
    systemctl --user restart wireplumber 2>/dev/null; sleep 2

    echo "== Making sure each sound card uses a normal input-capable profile (not Pro Audio / Off) =="
    pactl list cards 2>/dev/null | awk '
        function num(s, key) {
            if (match(s, key ": [0-9]+")) return substr(s, RSTART + length(key) + 2, RLENGTH - length(key) - 2) + 0
            return 0
        }
        function emit(   i, best, bs, sc, ncur) {
            if (name !~ /^alsa_card\./) return
            ncur = -1
            for (i = 1; i <= np; i++) if (P[i] == active) ncur = NS[i]
            if (active != "off" && active != "pro-audio" && ncur >= 1) return
            best = ""; bs = -1
            for (i = 1; i <= np; i++) {
                if (P[i] == "off" || P[i] == "pro-audio" || NS[i] < 1) continue
                sc = PR[i]
                if (active != "off" && active != "pro-audio" && index(P[i], active) == 1) sc += 1000000
                if (sc > bs) { bs = sc; best = P[i] }
            }
            if (best != "" && best != active) print name, best
        }
        /^Card #/ { emit(); name = ""; active = ""; np = 0; split("", P); split("", NS); split("", PR) }
        /^\tName:/ { name = $2 }
        /^\tActive Profile:/ { active = $3 }
        /^\t\t[^ \t]+: .*sources: [0-9]+.*available: yes\)/ {
            p = $1; sub(/:$/, "", p); P[++np] = p; NS[np] = num($0, "sources"); PR[np] = num($0, "priority")
        }
        END { emit() }
    ' | while read -r card want; do
        if pactl set-card-profile "$card" "$want" 2>/dev/null; then echo "  $card -> $want"; fi
    done

    echo "== Enabling ALSA capture controls =="
    for c in $(alsa_cards); do
        amixer -c "$c" scontrols 2>/dev/null \
          | sed -n "s/^Simple mixer control '\(.*\)',[0-9]*$/\1/p" \
          | while IFS= read -r ctl; do
            amixer -c "$c" sget "$ctl" 2>/dev/null | grep -qE 'cswitch|cvolume' || continue
            amixer -c "$c" -q sset "$ctl" capture 80% cap 2>/dev/null \
                || amixer -c "$c" -q sset "$ctl" cap 2>/dev/null || true
            echo "  card $c: $ctl"
        done
    done

    echo "== Selecting the external microphone port when one is plugged in =="
    pactl list sources 2>/dev/null | awk -v RS='Source #' '
        NR > 1 {
            n = split($0, L, "\n"); name = ""; act = ""; best = ""; bs = 0
            for (i = 1; i <= n; i++) {
                if (L[i] ~ /^\tName: /)        { name = L[i]; sub(/^\tName: /, "", name) }
                if (L[i] ~ /^\tActive Port: /) { act = L[i]; sub(/^\tActive Port: /, "", act) }
                if (L[i] ~ /^\t\tanalog-input-/ && L[i] !~ /not available/) {
                    p = L[i]; sub(/^\t\t/, "", p); sub(/:.*/, "", p)
                    sc = 0
                    if (p ~ /headset-mic/) sc = 4
                    else if (p ~ /headphone-mic/) sc = 3
                    else if (p ~ /internal|dock/) sc = 0
                    else if (p ~ /mic/) sc = 2
                    else if (p ~ /linein/) sc = 1
                    if (sc > bs) { bs = sc; best = p }
                }
            }
            if (name !~ /\.monitor$/ && best != "" && best != act) print name, best
        }' | while read -r src port; do
            pactl set-source-port "$src" "$port" 2>/dev/null && echo "  $src -> $port"
        done

    echo "== Unmuting PipeWire inputs =="
    for s in $(real_sources); do
        pactl set-source-mute "$s" 0 2>/dev/null
        pactl set-source-volume "$s" 80% 2>/dev/null
        echo "  $s"
    done
    def="$(pactl get-default-source 2>/dev/null)"
    if [[ -z "$def" || "$def" == *.monitor ]]; then
        first="$(real_sources | head -n1)"
        [[ -n "$first" ]] && pactl set-default-source "$first" && echo "  default input -> $first"
    fi
    echo; status
}

case "${1:-status}" in
    status) status ;;
    fix)    fix ;;
    *) echo "Usage: $0 [status|fix]"; exit 1 ;;
esac
