# ============================================================
# Cozy Dark i3 (X11)  -  same keys and structure as the Sway setup
# PipeWire audio, polybar panel, picom compositor, feh wallpapers
# ============================================================
set $mod Mod4
set $term kitty
set $menu rofi -show drun
set $browser firefox
set $files dolphin

# Cozy dark palette
set $bg      #1a1d2b
set $bg_alt  #232738
set $surface #2c3147
set $fg      #d9deee
set $muted   #8b93b0
set $accent  #8aa4ff
set $accent2 #b4a0ff
set $red     #ef8e9a

font pango:JetBrainsMono Nerd Font 10

# ---------- Startup ----------
exec_always --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3
exec_always --no-startup-id ~/.local/bin/wallpaper init
# Dark mode for GTK apps, file dialogs and browsers (read via xdg-desktop-portal)
exec_always --no-startup-id gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec_always --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
exec_always --no-startup-id ~/.local/bin/touchpad-setup
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id ~/.local/bin/desktop-mode reset
exec --no-startup-id dunst
exec --no-startup-id ~/.local/bin/obs-idle-guard
exec --no-startup-id nm-applet
exec --no-startup-id ~/.local/bin/polkit-agent
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -c 1a1d2b --nofork

# ---------- Look ----------
gaps inner 8
gaps outer 4
smart_gaps on
smart_borders on
default_border pixel 2
default_floating_border pixel 2

#                       border   background text   indicator child_border
client.focused          $accent  $bg_alt   $fg     $accent2  $accent
client.focused_inactive $surface $bg       $muted  $surface  $surface
client.unfocused        $bg_alt  $bg       $muted  $bg_alt   $bg_alt
client.urgent           $red     $red      $bg     $red      $red

# ---------- Apps ----------
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+b exec --no-startup-id $browser
bindsym $mod+e exec --no-startup-id $files

bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ---------- Focus / move ----------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ---------- Layout ----------
bindsym $mod+v split v
bindsym $mod+s split h
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+a focus parent
floating_modifier $mod

mode "resize" {
    bindsym h resize shrink width 20 px or 20 ppt
    bindsym j resize grow height 20 px or 20 ppt
    bindsym k resize shrink height 20 px or 20 ppt
    bindsym l resize grow width 20 px or 20 ppt
    bindsym Left resize shrink width 20 px or 20 ppt
    bindsym Down resize grow height 20 px or 20 ppt
    bindsym Up resize shrink height 20 px or 20 ppt
    bindsym Right resize grow width 20 px or 20 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---------- Workspaces ----------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# ---------- Audio (PipeWire / WirePlumber) ----------
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

bindsym $mod+n exec --no-startup-id pavucontrol
bindsym $mod+Shift+n exec --no-startup-id nm-connection-editor

# ---------- Wallpaper ----------
bindsym $mod+w exec --no-startup-id ~/.local/bin/wallpaper next
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/wallpaper random

# ---------- Screenshots / lock ----------
bindsym Print exec --no-startup-id maim -s ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym Shift+Print exec --no-startup-id maim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym Ctrl+Print exec --no-startup-id sh -c 'maim -s | xclip -selection clipboard -t image/png'
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1a1d2b

# ---------- Game / Business / Stream mode ----------
bindsym $mod+g exec --no-startup-id ~/.local/bin/desktop-mode toggle
bindsym $mod+Shift+g exec --no-startup-id ~/.local/bin/launch-game
bindsym $mod+Shift+b exec --no-startup-id ~/.local/bin/desktop-mode business
bindsym $mod+m exec --no-startup-id ~/.local/bin/desktop-mode menu

set $mode_system System: [g] Gaming [s] Stream [b] Business [l] Lock [q] Logout
mode "$mode_system" {
    bindsym g exec --no-startup-id ~/.local/bin/desktop-mode game, mode "default"
    bindsym s exec --no-startup-id ~/.local/bin/desktop-mode stream, mode "default"
    bindsym b exec --no-startup-id ~/.local/bin/desktop-mode business, mode "default"
    bindsym l exec --no-startup-id i3lock -c 1a1d2b, mode "default"
    bindsym q exec --no-startup-id i3-msg exit
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
bindsym $mod+Escape mode "$mode_system"

# ---------- VPN / Streaming / Bluetooth / Microphone ----------
bindsym $mod+Shift+v exec --no-startup-id ~/.local/bin/openvpn-menu
bindsym $mod+Shift+o exec --no-startup-id ~/.local/bin/desktop-mode stream
bindsym $mod+o exec --no-startup-id ~/.local/bin/obs-open
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/bluetooth-menu
bindsym $mod+Shift+m exec --no-startup-id ~/.local/bin/mic-menu
# Hide/show the panel (it shows IPs, weather, Wi-Fi) if you capture the whole screen
bindsym $mod+Shift+i exec --no-startup-id polybar-msg cmd toggle

# ---------- Window rules ----------
for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="steam"] move to workspace number 5
for_window [class="steam_app_.*"] move to workspace number 5

# OBS Studio: workspace 9, projector windows float
assign [class="obs"] workspace number 9
for_window [title="^(Windowed|Fullscreen) Projector.*"] floating enable

# File chooser / upload dialogs: floating, sensible size, centred
for_window [class="(?i)xdg-desktop-portal-gtk"] floating enable, resize set width 60 ppt height 70 ppt, move position center
for_window [class="(?i)zenity"] floating enable, move position center
for_window [title="^(File Upload|Open File|Open Files|Save As|Save File|Choose File.*|Select File.*)$"] floating enable, resize set width 60 ppt height 70 ppt, move position center
