[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 140
    origin = top-right
    offset = 18x18
    notification_limit = 5
    frame_width = 2
    frame_color = "#8aa4ff"
    separator_height = 2
    separator_color = "#2c3147"
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    font = JetBrainsMono Nerd Font 10
    corner_radius = 12
    transparency = 5
    timeout = 5

[urgency_low]
    background = "#1a1d2b"
    foreground = "#d9deee"
    frame_color = "#4b5270"
    timeout = 4

[urgency_normal]
    background = "#1a1d2b"
    foreground = "#d9deee"
    frame_color = "#8aa4ff"
    timeout = 5

[urgency_critical]
    background = "#1a1d2b"
    foreground = "#d9deee"
    frame_color = "#ef8e9a"
    timeout = 0
